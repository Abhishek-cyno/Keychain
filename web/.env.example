# Google Apps Script web app URL (ends with /exec).
#
# Leave blank, or set to "mock", to run against the in-browser demo data layer
# — useful before the sheet is deployed. The staff password in demo mode is
# "demo". Any other value is treated as the live API.
VITE_API_BASE=

# Public origin used to build the QR / NFC URLs shown in the admin UI.
#
# Leave blank in development so "Copy link" points at localhost.
# Production is https://tap.eqova.in — the app owns that whole domain, so a
# keychain URL is https://tap.eqova.in/<code> with no path prefix.
VITE_PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Postgres (Supabase) — the read path.
#
# With these set, taps resolve from the database in milliseconds instead of the
# 1.25-2.5s an Apps Script /exec round trip costs. VITE_API_BASE above stays
# set: it is the fallback if the database is ever unreachable, and it is still
# how new keychains are seeded.
#
# The anon key is PUBLIC by design and ships in the bundle. It is safe because
# the table has row-level security on with no policies and anon holds EXECUTE on
# exactly nine functions — see db/schema.sql. The service_role key is a
# different thing entirely: it belongs only in Apps Script Script Properties and
# must never appear here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
