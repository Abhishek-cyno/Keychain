# Google Apps Script web app URL (ends with /exec).
#
# Leave blank, or set to "mock", to run against the in-browser demo data layer
# — useful before the sheet is deployed. Any other value is treated as the
# live API.
VITE_API_BASE=

# Public origin used to build the QR / NFC URLs shown in the admin UI.
#
# Leave blank in development so "Copy URL" and "View" point at localhost.
# Set it to https://eqova.in for the production build, so staff copy the URL
# that is actually printed on the keychain.
VITE_PUBLIC_ORIGIN=
